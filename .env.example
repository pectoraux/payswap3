# Development-only configuration. Never commit secrets.
PAYSWAP_ENV=development
PAYSWAP_GOVERNANCE_STRICT=true
PAYSWAP_WORKER_PROVIDER=zai

# Product shell / authentication. Set these in the runtime environment.
PAYSWAP_ADMIN_EMAIL=admin@example.com
PAYSWAP_ADMIN_PASSWORD=change-me
PAYSWAP_SESSION_SECRET=replace-with-a-long-random-secret
PAYSWAP_DEMO_MODE=true

# Execution runtime. Keep unconfigured until a real execution service is deployed.
# The sandbox mode exercises the real execution kernel against the deterministic
# repository sandbox rail and does not move real funds.
PAYSWAP_EXECUTION_MODE=unconfigured

{
  "schemaVersion": 1,
  "unit": "one-work-item-per-branch-pr",
  "provider": "zai",
  "requiredContext": ["repositoryRevision","architectureVersion","workOrder","dependencies","ownedSurfaces","forbiddenSurfaces","assuranceProfile","checkpointContract","requiredProofs","dogfoodingContract"],
  "workerMay": ["inspect_repository","implement_work_order","add_tests","run_verification","run_dogfooding","persist_evidence_on_owned_surfaces","open_or_update_pr","update_own_in_flight_operational_state_when_required"],
  "workerMayNot": ["merge_own_pr","approve_own_pr","activate_work_order","complete_work_order","modify_another_work_item_scope","modify_frozen_architecture_without_acr","change_dependency_graph","change_roadmap_eligibility","change_assurance_requirements","invent_second_authority","rewrite_historical_evidence","treat_chat_as_source_of_truth","silently_fix_unrelated_findings"],
  "ownedOperationalWrites": ["own in-flight lastVerified revision","own branch/PR binding","own verification evidence references","own known limitations","own next mechanical action","own active handoff/resumption record when governance requires it"],
  "authoritativeDevelopmentState": ["governance-model.json","dependency-state.json","frontier-state.json","future-roadmap.json","protocol-registry.json","completed merge/finalization facts"],
  "completionReport": ["implementationRevision","baseRevision","changedSurfaces","checksRun","proofResults","dogfoodingResult","knownLimitations","scopeConfirmation","prNumber"],
  "parallelEligibility": "all hard dependencies complete AND no unresolved protected-surface conflict AND current-base rule satisfied",
  "mergeAuthority": "architect"
}
